# =====================================================================
# iboatlaspro.com - Environment Configuration Template
# =====================================================================

# 1. Admin Alerts & Notifications (Resend)
# Required for receiving real-time new order alerts and subscription expiration notices
ADMIN_ALERT_EMAIL=contact@iboatlaspro.com
RESEND_API_KEY=re_your_resend_api_key_here

# 2. Automated Expiration & Renewal Cron Security
# Secret bearer token used by scheduled cron runners calling /api/cron/subscriptions
CRON_SECRET=your_super_secret_cron_token_here

# 3. Public Contact & Messaging Channels
# Customer click-to-chat WhatsApp link with country code (e.g., https://wa.me/33600000000)
NEXT_PUBLIC_WHATSAPP_URL=https://wa.me/33600000000
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/iboatlaspro

# 4. Canonical Site URL
NEXT_PUBLIC_SITE_URL=https://iboatlaspro.com

# 5. Supabase PostgreSQL & Auth
# Obtain these from your Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

